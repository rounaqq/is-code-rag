# Virtual environment
.venv/

# Raw input data (IS Code PDFs)
data/raw/*.pdf
data/raw/*.tmp
!data/raw/registry.json
!data/raw/DVC_MANIFEST.md

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables and API keys
.env

# Audit logs
data/audit/

# OCR language models and temp debug images
data/tessdata/*.traineddata
data/raw/*.png

# Local Vector Database & Test Blueprints
data/processed/qdrant_storage/
data/processed/cad/api_test_*.dxf

# Step 3 extracted figure / equation crops (regenerable via figure_equation_extractor.py)
data/processed/figures/
data/processed/equations/

# DVC local remote storage (large PDF cache) & scratch
data/dvc_remote/
.dvc_tmp/

