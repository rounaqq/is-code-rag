# Git LFS (Large File Storage) Configuration
# Tracks raw standards PDFs, compiled vector embeddings, and CAD models without bloating Git commit history

# Official Bureau of Indian Standards PDFs & Supplementary Handbooks
*.pdf filter=lfs diff=lfs merge=lfs -text

# CAD Drawing Binaries & Vector Databases
*.dwg filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
