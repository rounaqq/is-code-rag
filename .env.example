# Comma-separated list of authorized API keys in format: name:key
IS_RAG_API_KEYS=demo_client:sk_is456_demo_key_abcdef123456

# LLM summarization endpoint (Ollama). The base URL is the Google Colab tunnel
# that hosts the model; the token is sent as the X-LLM-Token header.
# Leave OLLAMA_API_TOKEN empty to run the deterministic pipeline without an LLM.
OLLAMA_BASE_URL=https://<colab-tunnel-host>
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_TOKEN=
